# ==============================================================================
# GreenGlobe Email Configuration (Nodemailer)
# ==============================================================================
# Instructions for Gmail (Quickest setup):
# 1. Log in to your Google Account (e.g. greenglobeimports@gmail.com).
# 2. Go to: https://myaccount.google.com/security
# 3. Ensure 2-Step Verification is turned ON.
# 4. Search for "App Passwords" (or visit https://myaccount.google.com/apppasswords).
# 5. Create a new App Password named "GreenGlobe Website".
# 6. Copy the 16-character code (e.g., "abcd efgh ijkl mnop") into SMTP_PASS below.
# ==============================================================================

# Option 1: Gmail (Standard)
SMTP_USER=greenglobeimports@gmail.com
SMTP_PASS=your_16_character_app_password

# Where contact form inquiries should be delivered:
CONTACT_RECEIVER_EMAIL=greenglobeimports@gmail.com

# ------------------------------------------------------------------------------
# Option 2: Custom SMTP Server (Hostinger, cPanel, AWS SES, SendGrid, etc.)
# Uncomment and configure the lines below if not using Gmail:
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@yourdomain.com
# SMTP_PASS=your_smtp_password
# CONTACT_RECEIVER_EMAIL=greenglobeimports@gmail.com
